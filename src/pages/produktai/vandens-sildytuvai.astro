---
import ProductLayout from '../../layouts/ProductLayout.astro';
import '../../styles/global.css';
---

<ProductLayout
  title="Vandens šildytuvai — elektriniai ir dujiniai | IdeaTherm"
  description="Kokybiški vandens šildytuvai namams ir verslui. Elektriniai, dujiniai, šilumos siurblių modeliai. Greitas pristatymas ir profesionalus montavimas visoje Lietuvoje."
  canonicalURL="https://www.idejasildymui.lt/produktai/vandens-sildytuvai"
  heroTitle="Vandens šildytuvai — efektyvus karšto vandens sprendimas"
  heroSubtitle="Platus asortimentas vandens šildytuvų — nuo kompaktiškų elektrinių iki galingų dujinių modelių namams ir verslui."
>

  <section class="section">
    <div class="section__inner">
      <p class="about__text">
        UAB „IdeaTherm" siūlo plačiausią vandens šildytuvų pasirinkimą Lietuvoje. Mūsų
        asortimente rasite elektrinius, dujinius ir šilumos siurblių vandens šildytuvus
        įvairiems poreikiams — nuo vieno kambario buto iki didelio komercinio objekto.
        Bendradarbiaujame su geriausiomis Europos gamintojų markėmis ir garantuojame
        kokybę bei ilgą tarnavimo laiką.
      </p>
      <div class="cta-center">
        <a href="/#kontaktai" class="btn">Susisiekite dėl kainos</a>
      </div>
      <p class="coming-soon">Daugiau informacijos netrukus</p>
    </div>
  </section>

</ProductLayout>
