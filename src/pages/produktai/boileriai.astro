---
import ProductLayout from '../../layouts/ProductLayout.astro';
import '../../styles/global.css';

const jsonLdProduct = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": "Boileriai",
  "brand": {
    "@type": "Brand",
    "name": "IdeaTherm"
  },
  "description": "Kokybiški boileriai namams ir verslui. 80L–500L talpos, A+ energijos klasė.",
  "url": "https://www.idejasildymui.lt/produktai/boileriai"
};
---

<ProductLayout
  title="Boileriai — karšto vandens talpyklos | IdeaTherm"
  description="Kokybiški boileriai namams ir verslui. 80L–500L talpos, A+ energijos klasė. Greitas pristatymas ir montavimas visoje Lietuvoje."
  canonicalURL="https://www.idejasildymui.lt/produktai/boileriai"
  heroTitle="Boileriai — karšto vandens talpyklos namams ir verslui"
  heroSubtitle="Plataus pasirinkimo boileriai su puikia šilumos izoliacija. Tinka privatiems namams, daugiabučiams ir komercinėms patalpoms."
  jsonLdExtra={jsonLdProduct}
>

  <!-- ===== WHY BOILERS ===== -->
  <section class="section">
    <div class="section__inner">
      <h2 class="section__title">Kodėl verta rinktis boilerį?</h2>
      <div class="section__divider"></div>
      <div class="benefits-grid">
        <div class="benefit-card">
          <span class="benefit-card__icon" aria-hidden="true">🌡️</span>
          <h3>Pastovi vandens temperatūra</h3>
          <p>Boileris užtikrina nuolat karštą vandenį bet kuriuo paros metu.</p>
        </div>
        <div class="benefit-card">
          <span class="benefit-card__icon" aria-hidden="true">💰</span>
          <h3>Ekonomiškas šildymas</h3>
          <p>Naktiniu tarifu įkaitiname vandenį pigiau — taupote kasmet.</p>
        </div>
        <div class="benefit-card">
          <span class="benefit-card__icon" aria-hidden="true">🏠</span>
          <h3>Tinka visiems namams</h3>
          <p>Nuo 50L iki 500L talpos modeliai kiekvienam poreikiui.</p>
        </div>
        <div class="benefit-card">
          <span class="benefit-card__icon" aria-hidden="true">🔧</span>
          <h3>Lengva priežiūra</h3>
          <p>Ilgalaikis patikimumas su minimalia priežiūra.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== PRODUCT VARIANTS TABLE ===== -->
  <section class="section section--gray">
    <div class="section__inner">
      <h2 class="section__title">Populiariausi modeliai</h2>
      <div class="section__divider"></div>
      <div class="pricing-table-wrap">
        <table class="pricing-table">
          <thead>
            <tr>
              <th>Talpa</th>
              <th>Galia</th>
              <th>Energijos klasė</th>
              <th>Kaina nuo</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>80 L</td>
              <td>2 kW</td>
              <td>B</td>
              <td>180 €</td>
              <td><a href="/#kontaktai" class="btn btn--sm">Užklausti</a></td>
            </tr>
            <tr>
              <td>120 L</td>
              <td>2 kW</td>
              <td>B</td>
              <td>240 €</td>
              <td><a href="/#kontaktai" class="btn btn--sm">Užklausti</a></td>
            </tr>
            <tr>
              <td>200 L</td>
              <td>3 kW</td>
              <td>A</td>
              <td>380 €</td>
              <td><a href="/#kontaktai" class="btn btn--sm">Užklausti</a></td>
            </tr>
            <tr>
              <td>300 L</td>
              <td>3 kW</td>
              <td>A+</td>
              <td>520 €</td>
              <td><a href="/#kontaktai" class="btn btn--sm">Užklausti</a></td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- ===== FAQ ===== -->
  <section class="section">
    <div class="section__inner">
      <h2 class="section__title">Dažnai užduodami klausimai</h2>
      <div class="section__divider"></div>
      <div class="faq-list">
        <details class="faq-item">
          <summary>Kokio dydžio boileris man tinka?</summary>
          <p>Rekomenduojama ~50L vienam žmogui. 4 asmenų šeimai tinka 200L boileris.</p>
        </details>
        <details class="faq-item">
          <summary>Kiek laiko trunka montavimas?</summary>
          <p>Standartinis montavimas užtrunka 2–4 valandas. Mūsų meistrai atvyksta sutartu laiku.</p>
        </details>
        <details class="faq-item">
          <summary>Ar galima prijungti saulės kolektorius?</summary>
          <p>Taip, turime dviejų kontūrų boilerių modelių, suderintų su saulės kolektoriais.</p>
        </details>
      </div>
    </div>
  </section>

  <!-- ===== CTA BANNER ===== -->
  <section class="cta-banner">
    <div class="cta-banner__inner">
      <p class="cta-banner__text">Norite gauti kainą? Susisiekite su mumis!</p>
      <a href="/#kontaktai" class="btn">Susisiekite</a>
    </div>
  </section>

</ProductLayout>
